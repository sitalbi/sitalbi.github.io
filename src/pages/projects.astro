---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects · Simon Talbi" description="Portfolio projects">
  <header class="page-heading">
    <p class="eyebrow">Selected work</p>
    <h1>Projects</h1>
    <p>A selection of personal projects.</p>
  </header>
  <ProjectList items={projects} />
  <div class="more-link">
    <a href="https://github.com/sitalbi" target="_blank" rel="noopener noreferrer">More on GitHub <span aria-hidden="true">↗</span></a>
  </div>
</BaseLayout>
