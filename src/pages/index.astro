---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Simon Talbi" description="Portfolio website">
 <div class="hero">
  <div class="hero-text">
    <h1>Hi, I'm Simon!</h1>
    <h2 class="muted"><i>Game Programmer</i></h2>
  </div>

  <div class="hero-image">
    <img src="https://avatars.githubusercontent.com/u/64929584?v=4" alt="Simon Talbi" />
  </div>
</div>

<p> I am a French gameplay programmer currently working in Japan, passionate about creating games and the technology behind them. I particularly enjoy developing character mechanics and gameplay systems, while also exploring game engines, rendering, and performance. This website showcases a selection of my personal game projects and technical experiments. </p>

<h2>About</h2>

<p>
  After graduating with a master's degree in Software Engineering from the University of Bordeaux, France, I moved to Japan, where I now work as a game programmer contributing to both AA and AAA client projects as well as internal game development and R&D projects.
  My professional experience includes gameplay programming in Unreal Engine 5, Unity and proprietary engines, development of game systems,
  technical investigation, performance optimization, and R&D on game-related technologies.
</p>

<p>
  I particularly enjoy developing gameplay systems and understanding how they interact with the underlying engine.
  In my free time, I work on personal game prototypes and technical projects to explore topics such as character mechanics,
  gameplay architecture, engine programming, rendering technology, and performance.
</p>


  <h2>A selection of personal projects</h2>

  <div class="projects-grid">
    {
      projects.map((project) => (
        <a href={project.url} class="project-card">
          <img src={project.image} alt={project.title} class="project-image" />

          <div class="project-card-body">
            <div class="project-card-kicker">{project.category}</div>
            <h2 class="project-card-title">{project.title}</h2>
            <p class="project-card-description">{project.description}</p>
            <div class="project-card-tags">
              {project.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <div class="projects-more">
    <a
      href="https://github.com/sitalbi"
      target="_blank"
      rel="noopener noreferrer"
      class="see-more-button"
    >
      <img
        src="data:image/svg+xml;base64,"
        alt="GitHub"
      />
      More on GitHub
    </a>
  </div>

  <h2>Links</h2>

  <div class="social-links">
    <a
      href="mailto:simon.talbi0111@gmail.com"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="data:image/svg+xml;base64,"
        alt="Mail"
      />
    </a>

    <a
      href="https://github.com/sitalbi"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="data:image/svg+xml;base64,"
        alt="GitHub"
      />
    </a>

    <a
      href="https://www.linkedin.com/in/simon-talbi/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="data:image/svg+xml;base64,"
        alt="LinkedIn"
      />
    </a>
  </div>
</BaseLayout>
