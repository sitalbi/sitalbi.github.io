---
const { title = "Portfolio", description = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const theme = saved === "light" || saved === "dark"
          ? saved
          : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <style>
      :root {
        color-scheme: light;
        --bg: #f8fafb;
        --surface: #ffffff;
        --text: #20262d;
        --muted: #68727c;
        --faint: #8b949d;
        --border: #dce2e7;
        --accent: #0788a8;
        --accent-strong: #006f8b;
        --accent-soft: #e4f5f8;
        --overlay: rgba(10, 16, 20, 0.88);
        --max-width: 960px;
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #292d30;
        --surface: #32373a;
        --text: #edf1f2;
        --muted: #bdc4c8;
        --faint: #929b9f;
        --border: #454b4f;
        --accent: #31b4d1;
        --accent-strong: #6ed1e5;
        --accent-soft: #263f45;
        --overlay: rgba(4, 7, 8, 0.92);
      }

      * { box-sizing: border-box; }
      html { font-size: 16px; scroll-behavior: smooth; }
      body {
        margin: 0;
        min-width: 300px;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        font-size: 1rem;
        line-height: 1.7;
        transition: background-color .2s ease, color .2s ease;
      }

      a, a:visited { color: inherit; text-decoration: none; }
      a:hover, a:visited:hover { color: var(--accent); }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 2px; }
      img { display: block; max-width: 100%; height: auto; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 30;
        background: color-mix(in srgb, var(--bg) 91%, transparent);
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(14px);
      }
      .site-header-inner {
        width: min(var(--max-width), calc(100% - 40px));
        height: 58px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }
      .brand { color: var(--text); font-weight: 750; letter-spacing: -.02em; text-decoration: none; }
      .header-actions, nav { display: flex; align-items: center; gap: 20px; }
      nav a { color: var(--muted); font-size: .93rem; font-weight: 600; text-decoration: none; }
      nav a:hover { color: var(--accent); }
      .theme-toggle {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
      }
      .theme-toggle:hover { color: var(--accent); }
      .theme-toggle svg { width: 19px; height: 19px; fill: currentColor; }
      .moon { display: block; }
      .sun { display: none; }
      :root[data-theme="dark"] .moon { display: none; }
      :root[data-theme="dark"] .sun { display: block; }

      main { width: min(var(--max-width), calc(100% - 40px)); margin: 0 auto; padding: 58px 0 72px; }
      section + section { margin-top: 68px; }
      h1, h2, h3 { margin-top: 0; color: var(--text); line-height: 1.25; }
      h1 { margin-bottom: 18px; font-size: clamp(2.1rem, 5vw, 3.4rem); letter-spacing: -.045em; }
      h2 {
        width: fit-content;
        margin-bottom: 28px;
        padding-bottom: 7px;
        border-bottom: 3px solid var(--accent);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.65rem;
        letter-spacing: -.02em;
      }
      h3 { margin-bottom: 7px; font-size: 1.12rem; }
      p { margin: 0 0 1rem; color: var(--muted); }
      p:last-child { margin-bottom: 0; }
      .eyebrow { margin-bottom: 8px; color: var(--accent); font-size: .78rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }

      :global(.intro) { display: grid; grid-template-columns: 230px 1fr; align-items: center; gap: 54px; }
      :global(.profile-column) { display: flex; flex-direction: column; align-items: center; gap: 20px; }
      :global(.profile-photo) { width: 210px; height: 210px; border-radius: 50%; object-fit: cover; filter: saturate(.82); }
      :global(.intro-copy p:last-child) { max-width: 64ch; font-size: 1.05rem; }
      :global(.social-links) { display: flex; gap: 17px; }
      :global(.social-links a) { color: var(--text); line-height: 1; }
      :global(.social-links svg) { width: 23px; height: 23px; fill: currentColor; }

      :global(.timeline) { margin-left: 4px; border-left: 1px solid var(--border); }
      :global(.timeline-item) { position: relative; display: grid; grid-template-columns: 180px 1fr; gap: 28px; padding: 4px 0 35px 20px; }
      :global(.timeline-item:last-child) { padding-bottom: 0; }
      :global(.timeline-item::before) { content: ""; position: absolute; top: 10px; left: -5px; width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
      :global(.timeline-meta) { display: flex; flex-direction: column; color: var(--faint); font-size: .83rem; font-weight: 600; }
      :global(.timeline-copy h3) { margin: 0; }
      :global(.timeline-copy .company) { margin: 2px 0 9px; color: var(--accent-strong); font-weight: 650; }
      :global(.timeline-copy p:not(.company)) { margin: 0; font-size: .94rem; }

      :global(.project-list) { display: flex; flex-direction: column; }
      :global(.project-row) { display: grid; grid-template-columns: 230px 1fr; gap: 28px; padding: 26px 0; border-top: 1px solid var(--border); }
      :global(.project-row:first-child) { padding-top: 0; border-top: 0; }
      :global(.project-thumb) { align-self: start; overflow: hidden; background: var(--surface); aspect-ratio: 16 / 9; }
      :global(.project-thumb img) { width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease, opacity .25s ease; }
      :global(.project-thumb:hover img) { transform: scale(1.025); opacity: .9; }
      :global(.project-category) { margin: 0 0 4px; color: var(--faint); font-size: .7rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
      :global(.project-copy h3) { margin: 0 0 6px; font-size: 1.15rem; }
      :global(.project-copy h3 a) { color: var(--text); text-decoration: none; }
      :global(.project-copy h3 a:hover) { text-decoration: none; }
      :global(.project-description) { margin: 0; font-size: .94rem; }
      :global(.project-card-tags), :global(.project-tags) { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
      :global(.project-card-tags span), :global(.project-tags span) { padding: 3px 8px; border: 1px solid var(--border); color: var(--muted); font-size: .72rem; line-height: 1.4; }
      :global(.all-projects), :global(.more-link a) { display: inline-block; margin-top: 22px; font-weight: 650; text-decoration: none; }
      :global(.text-links) { display: flex; flex-wrap: wrap; gap: 22px; }
      :global(.text-links a) { font-weight: 650; }

      :global(.page-heading) { margin-bottom: 44px; }
      :global(.page-heading h1) { margin-bottom: 5px; }
      :global(.more-link) { margin-top: 10px; }

      :global(main > h1) { margin-bottom: 24px; }
      :global(main > h2), :global(main > h3) { margin-top: 45px; }
      :global(main > p), :global(main > ul), :global(main > ol), :global(main > pre), :global(main > blockquote), :global(main > .project-meta) { max-width: 760px; }
      :global(main > img:first-of-type), :global(.project-hero-image) { width: 100%; margin: 8px 0 25px; border: 1px solid var(--border); cursor: zoom-in; }
      :global(.project-meta) { margin-bottom: 32px; }
      :global(.project-links) { margin-bottom: 10px; }
      :global(.project-link) { display: inline-flex; align-items: center; gap: 8px; font-weight: 650; text-decoration: none; }
      :global(.project-link .icon) { width: 18px; height: 18px; border-radius: 0; }
      :global(.project-gallery) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 18px 0 32px; }
      :global(.gallery-image), :global(.project-gallery img) { width: 100%; border: 1px solid var(--border); cursor: zoom-in; }
      :global(pre) { overflow-x: auto; padding: 17px; border: 1px solid var(--border); background: var(--surface); }
      :global(code), :global(pre) { font-family: "Cascadia Code", Consolas, monospace; }
      :global(blockquote) { margin-left: 0; padding-left: 18px; border-left: 3px solid var(--accent); }

      .site-footer { width: min(var(--max-width), calc(100% - 40px)); margin: 0 auto; padding: 22px 0 34px; border-top: 1px solid var(--border); color: var(--faint); font-size: .84rem; }
      .lightbox { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 34px; background: var(--overlay); opacity: 0; pointer-events: none; transition: opacity .18s ease; }
      .lightbox.open { opacity: 1; pointer-events: auto; }
      .lightbox-image { max-width: min(1200px, 92vw); max-height: 88vh; object-fit: contain; }
      .lightbox-close { position: absolute; top: 18px; right: 20px; width: 44px; height: 44px; border: 1px solid rgba(255,255,255,.4); border-radius: 50%; background: rgba(0,0,0,.25); color: #fff; font-size: 1.8rem; line-height: 1; cursor: pointer; }

      @media (max-width: 720px) {
        .site-header-inner, main, .site-footer { width: min(100% - 28px, var(--max-width)); }
        .site-header-inner { height: 54px; }
        .header-actions, nav { gap: 13px; }
        nav a { font-size: .86rem; }
        main { padding: 40px 0 55px; }
        section + section { margin-top: 52px; }
        :global(.intro) { grid-template-columns: 1fr; gap: 25px; text-align: center; }
        :global(.profile-photo) { width: 155px; height: 155px; }
        :global(.intro-copy p:last-child) { text-align: left; }
        :global(.timeline-item) { grid-template-columns: 1fr; gap: 8px; }
        :global(.timeline-meta) { flex-direction: row; flex-wrap: wrap; gap: 6px 12px; }
        :global(.project-row) { grid-template-columns: 130px 1fr; gap: 16px; }
        :global(.project-card-tags) { display: none; }
        :global(.project-gallery) { grid-template-columns: 1fr; }
      }

      @media (max-width: 480px) {
        .brand { font-size: .92rem; }
        nav a:first-child { display: none; }
        :global(.project-row) { grid-template-columns: 1fr; }
        :global(.project-thumb) { width: 100%; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
      }
    </style>
    <style is:global>
      main a:not([aria-label]),
      main a:not([aria-label]):visited {
        color: var(--text);
        text-decoration: none;
      }
      main a:not([aria-label]):hover,
      main a:not([aria-label]):visited:hover {
        color: var(--accent);
        text-decoration: none;
      }
      main section + section { margin-top: 68px; }
      main h1, main h2, main h3 { margin-top: 0; color: var(--text); line-height: 1.25; }
      main h1 { margin-bottom: 18px; font-size: clamp(2.1rem, 5vw, 3.4rem); letter-spacing: -.045em; }
      main h2 { width: fit-content; margin-bottom: 28px; padding-bottom: 7px; border-bottom: 3px solid var(--accent); font-family: Georgia, "Times New Roman", serif; font-size: 1.65rem; letter-spacing: -.02em; }
      main h3 { margin-bottom: 7px; font-size: 1.12rem; }
      main p { margin: 0 0 1rem; color: var(--muted); text-align: justify; hyphens: auto; }
      main p:last-child { margin-bottom: 0; }
      main .eyebrow { margin-bottom: 8px; color: var(--accent); font-size: .78rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
      @media (max-width: 720px) { main section + section { margin-top: 52px; } }

      .intro { display: grid; grid-template-columns: 230px 1fr; align-items: center; gap: 54px; }
      .profile-column { display: flex; flex-direction: column; align-items: center; gap: 20px; }
      .profile-photo { width: 210px; height: 210px; border-radius: 50%; object-fit: cover; filter: saturate(.82); }
      .intro-copy p:last-child { max-width: 64ch; font-size: 1.05rem; }
      .social-links { display: flex; gap: 17px; }
      .social-links a { color: var(--text); line-height: 1; }
      .social-links svg { width: 23px; height: 23px; fill: currentColor; }

      .timeline { margin-left: 4px; border-left: 1px solid var(--border); }
      .timeline-item { position: relative; display: grid; grid-template-columns: 180px 1fr; gap: 28px; padding: 4px 0 35px 20px; }
      .timeline-item:last-child { padding-bottom: 0; }
      .timeline-item::before { content: ""; position: absolute; top: 10px; left: -5px; width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
      .timeline-meta { display: flex; flex-direction: column; color: var(--faint); font-size: .83rem; font-weight: 600; }
      .timeline-copy h3 { margin: 0; }
      .timeline-copy .company { margin: 2px 0 9px; color: var(--accent-strong); font-weight: 650; }
      .timeline-copy p:not(.company) { margin: 0; font-size: .94rem; }

      .project-list { display: flex; flex-direction: column; }
      .project-row { display: grid; grid-template-columns: 230px 1fr; gap: 28px; padding: 26px 0; border-top: 1px solid var(--border); }
      .project-row:first-child { padding-top: 0; border-top: 0; }
      .project-thumb { align-self: start; overflow: hidden; background: var(--surface); aspect-ratio: 16 / 9; }
      .project-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease, opacity .25s ease; }
      .project-thumb:hover img { transform: scale(1.025); opacity: .9; }
      .project-category { margin: 0 0 4px; color: var(--faint); font-size: .7rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
      .project-copy h3 { margin: 0 0 6px; font-size: 1.15rem; }
      .project-copy h3 a { color: var(--text); text-decoration: none; }
      .project-copy h3 a:hover { text-decoration: none; }
      .project-description { margin: 0; font-size: .94rem; }
      .project-card-tags, .project-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
      .project-card-tags span, .project-tags span { padding: 3px 8px; border: 1px solid var(--border); color: var(--muted); font-size: .72rem; line-height: 1.4; }
      .all-projects, .more-link a { display: inline-block; margin-top: 22px; font-weight: 650; text-decoration: none; }
      .text-links { display: flex; flex-wrap: wrap; gap: 22px; }
      .text-links a { font-weight: 650; }

      .page-heading { margin-bottom: 44px; }
      .page-heading h1 { margin-bottom: 5px; }
      .more-link { margin-top: 10px; }
      main > h1 { margin-bottom: 24px; }
      main > h2, main > h3 { margin-top: 45px; }
      main > p, main > ul, main > ol, main > pre, main > blockquote, main > .project-meta { max-width: 760px; }
      main > img:first-of-type, main > p:first-of-type > img, .project-hero-image { width: 100%; margin: 8px 0 25px; border: 1px solid var(--border); cursor: zoom-in; }
      .project-meta { margin-bottom: 32px; }
      .project-links { margin-bottom: 10px; }
      .project-link { display: inline-flex; align-items: center; gap: 8px; font-weight: 650; text-decoration: none; }
      .project-link .icon { width: 18px; height: 18px; border-radius: 0; }
      .project-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 18px 0 32px; }
      .gallery-image, .project-gallery img { width: 100%; border: 1px solid var(--border); cursor: zoom-in; }
      pre { overflow-x: auto; padding: 17px; border: 1px solid var(--border); background: var(--surface); }
      code, pre { font-family: "Cascadia Code", Consolas, monospace; }
      blockquote { margin-left: 0; padding-left: 18px; border-left: 3px solid var(--accent); }

      @media (max-width: 720px) {
        .intro { grid-template-columns: 1fr; gap: 25px; text-align: center; }
        .profile-photo { width: 155px; height: 155px; }
        .intro-copy p:last-child { text-align: justify; }
        .timeline-item { grid-template-columns: 1fr; gap: 8px; }
        .timeline-meta { flex-direction: row; flex-wrap: wrap; gap: 6px 12px; }
        .project-row { grid-template-columns: 130px 1fr; gap: 16px; }
        .project-card-tags { display: none; }
        .project-gallery { grid-template-columns: 1fr; }
      }
      @media (max-width: 480px) {
        .project-row { grid-template-columns: 1fr; }
        .project-thumb { width: 100%; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand">Simon Talbi</a>
        <div class="header-actions">
          <nav aria-label="Primary navigation"><a href="/">Home</a><a href="/projects">Projects</a></nav>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.6A8.5 8.5 0 0 1 8.4 3.6 9 9 0 1 0 20.4 15.6Z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0-5h1v3h-2V2h1Zm0 17h1v3h-2v-3h1ZM2 11h3v2H2v-2Zm17 0h3v2h-3v-2ZM4.22 5.64l1.42-1.42 2.12 2.12-1.42 1.42-2.12-2.12Zm12.02 12.02 1.42-1.42 2.12 2.12-1.42 1.42-2.12-2.12ZM18.36 4.22l1.42 1.42-2.12 2.12-1.42-1.42 2.12-2.12ZM6.34 16.24l1.42 1.42-2.12 2.12-1.42-1.42 2.12-2.12Z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main><slot /></main>
    <footer class="site-footer">© 2026 Simon Talbi</footer>

    <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
      <button id="lightbox-close" class="lightbox-close" aria-label="Close image viewer">×</button>
      <img id="lightbox-image" class="lightbox-image" src="" alt="" />
    </div>

    <script is:inline>
      const root = document.documentElement;
      const themeToggle = document.getElementById("theme-toggle");
      themeToggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
      });

      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxClose = document.getElementById("lightbox-close");
      let previousFocus;

      const closeLightbox = () => {
        lightbox?.classList.remove("open");
        lightbox?.setAttribute("aria-hidden", "true");
        if (lightboxImage instanceof HTMLImageElement) lightboxImage.src = "";
        if (previousFocus instanceof HTMLElement) previousFocus.focus();
      };

      document.addEventListener("click", (event) => {
        const target = event.target;
        const isProjectImage = target instanceof HTMLImageElement && target.closest("main") && !target.closest(".intro") && !target.closest(".project-thumb") && !target.classList.contains("icon");
        if (target instanceof HTMLImageElement && (target.classList.contains("gallery-image") || isProjectImage)) {
          previousFocus = target;
          if (lightboxImage instanceof HTMLImageElement) { lightboxImage.src = target.src; lightboxImage.alt = target.alt || ""; }
          lightbox?.classList.add("open");
          lightbox?.setAttribute("aria-hidden", "false");
          lightboxClose?.focus();
        }
      });
      lightboxClose?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (event) => { if (event.target === lightbox) closeLightbox(); });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape" && lightbox?.classList.contains("open")) closeLightbox(); });
    </script>
  </body>
</html>
