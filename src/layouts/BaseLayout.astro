---
const { title = "Portfolio", description = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style>
      :root {
        --bg: #eef2f7;
        --bg-2: #f8fafc;
        --surface: #ffffff;
        --surface-2: #f4f7fb;
        --surface-3: #edf4ff;
        --text: #111827;
        --muted: #5b6472;
        --border: #d9dee8;
        --accent: #1f4f8f;
        --accent-2: #22314d;
        --accent-soft: #e8f0fb;
        --max-width: 1080px;
        --radius: 18px;
        --shadow: 0 18px 55px rgba(17, 24, 39, 0.08);
        --shadow-soft: 0 10px 30px rgba(17, 24, 39, 0.06);
      }

      * { box-sizing: border-box; }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(31, 79, 143, 0.12), transparent 35rem),
          linear-gradient(180deg, var(--bg-2) 0%, var(--bg) 100%);
        color: var(--text);
        font-family: "Manrope", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.75;
      }

      a { color: inherit; }

      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 34px 20px 74px;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(16px);
        background: rgba(248, 250, 252, 0.78);
        border-bottom: 1px solid rgba(217, 222, 232, 0.75);
      }

      .site-header-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 13px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        position: relative;
        font-weight: 800;
        text-decoration: none;
        letter-spacing: -0.03em;
      }

      nav {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      nav a {
        text-decoration: none;
        color: var(--muted);
        padding: 8px 13px;
        border-radius: 999px;
        font-weight: 650;
        font-size: 0.94rem;
        transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
      }

      nav a:hover {
        background: var(--surface);
        color: var(--accent);
        transform: translateY(-1px);
        box-shadow: var(--shadow-soft);
      }

      .page-shell { margin-top: 22px; }

      .page-card {
        position: relative;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(217, 222, 232, 0.9);
        border-radius: 28px;
        box-shadow: var(--shadow);
        padding: 44px 38px;
      }

      .page-card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 7px;
        background: linear-gradient(180deg, var(--accent), var(--accent-2));
      }

      h1, h2, h3 {
        line-height: 1.13;
        letter-spacing: -0.035em;
        margin-top: 0;
        color: var(--text);
      }

      h1 {
        font-size: clamp(2.35rem, 4.8vw, 4.2rem);
        margin-bottom: 0.8rem;
      }

      h2 {
        font-size: clamp(1.35rem, 2vw, 1.85rem);
        margin-top: 2.7rem;
        margin-bottom: 0.85rem;
      }

      h2::before {
        content: "";
        display: inline-block;
        width: 22px;
        height: 3px;
        margin-right: 10px;
        vertical-align: middle;
        border-radius: 999px;
        background: var(--accent);
      }

      h3 {
        font-size: 1.1rem;
        margin-top: 1.8rem;
        margin-bottom: 0.6rem;
      }

      p { margin: 0 0 1rem; color: #263244; }
      .muted { color: var(--muted); }
      .lead { font-size: 1.08rem; color: #303b4c; max-width: 65ch; }

      ul, ol { padding-left: 1.2rem; }
      li { margin: 0.38rem 0; }

      img {
        max-width: 100%;
        height: auto;
        display: block;
        border-radius: 14px;
      }

      code, pre { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, monospace; }

      pre {
        overflow-x: auto;
        padding: 16px 18px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #f8fafc;
      }

      blockquote {
        margin: 1.5rem 0;
        padding: 0.2rem 0 0.2rem 1rem;
        border-left: 4px solid var(--accent);
        color: var(--muted);
        background: var(--surface-2);
        border-radius: 0 12px 12px 0;
      }

      hr { border: none; border-top: 1px solid var(--border); margin: 2.2rem 0; }
      .section-intro { margin-bottom: 1.25rem; }

      .chip-row, :global(.project-tags), :global(.project-card-tags) {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 1rem;
      }

      .chip, :global(.project-tags span), :global(.project-card-tags span) {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        background: var(--accent-soft);
        border: 1px solid #c9d8ee;
        border-radius: 999px;
        color: #173b6b;
        font-size: 0.8rem;
        font-weight: 750;
        line-height: 1;
      }

      .footer {
        max-width: var(--max-width);
        margin: 24px auto 0;
        padding: 0 20px;
        color: var(--muted);
        font-size: 0.92rem;
      }

      :global(.hero) {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 2rem;
        padding: 8px 0 18px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 22px;
      }

      :global(.hero-text) { flex: 1; }
      :global(.hero h1) { margin-bottom: 0.4rem; }
      :global(.hero h2) { margin: 0; font-size: 1.15rem; letter-spacing: -0.02em; }
      :global(.hero h2::before) { display: none; }
      :global(.hero-image) { flex-shrink: 0; }
      :global(.hero-image img) {
        width: 152px;
        height: 152px;
        object-fit: cover;
        border-radius: 28px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow-soft);
      }

      :global(.projects-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(285px, 1fr));
        gap: 1.35rem;
        margin-top: 1.5rem;
      }

      :global(.project-card) {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100%;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 0;
        transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
      }

      :global(.project-card:hover) {
        transform: translateY(-4px);
        box-shadow: var(--shadow);
        border-color: #b9c9df;
      }

      :global(.project-card .project-image) {
        width: 100%;
        max-width: none;
        aspect-ratio: 16 / 9;
        height: auto;
        object-fit: cover;
        border: none;
        border-radius: 0;
        cursor: pointer;
        background: #101827;
        transition: transform 0.22s ease;
      }

      :global(.project-card:hover .project-image) { transform: scale(1.025); }

      :global(.project-card-body) { padding: 1.15rem 1.2rem 1.25rem; }

      :global(.project-card-kicker) {
        margin-bottom: 0.45rem;
        color: var(--accent);
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      :global(.project-card-title) {
        margin: 0 0 0.55rem;
        font-size: 1.25rem;
      }

      :global(.project-card-title a) { color: var(--text); text-decoration: none; }
      :global(.project-card-title a:hover) { color: var(--accent); }

      :global(.project-card-description) {
        color: var(--muted);
        margin: 0;
        font-size: 0.96rem;
      }

      :global(.project-meta) {
        margin: 1rem 0 1.5rem 0;
      }

      :global(.project-links) {
        margin-bottom: 0.75rem;
      }

      :global(.project-links a) {
        text-decoration: none;
        font-weight: 500;
      }

      :global(.project-links a:hover) {
        text-decoration: underline;
      }

      :global(.project-tags) {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      :global(.project-links) {
        margin-bottom: 0.75rem;
      }

      :global(.project-link) {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--text);
        font-weight: 500;
      }

      :global(.project-link:hover) {
        text-decoration: underline;
      }

      :global(.project-link .icon) {
        width: 18px;
        height: 18px;
        opacity: 0.8;
      }


      :global(.project-hero-image), :global(main > img:first-of-type) {
        width: 100%;
        max-width: 920px;
        height: auto;
        display: block;
        margin: 1.45rem auto 1.8rem;
        border-radius: 18px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow-soft);
      }

      :global(.project-gallery) {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-top: 1rem;
      }

      :global(.gallery-image), :global(.project-gallery img) {
        width: 100%;
        max-width: 100%;
        height: auto;
        display: block;
        border-radius: 14px;
        border: 1px solid var(--border);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      :global(.gallery-image:hover), :global(.project-gallery img:hover) {
        transform: translateY(-2px);
        box-shadow: var(--shadow-soft);
      }

      :global(.projects-more) { margin-top: 2rem; text-align: center; }

      :global(.see-more-button) {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 10px 17px;
        border-radius: 999px;
        border: 1px solid #c9d8ee;
        background: var(--accent);
        text-decoration: none;
        color: white;
        font-weight: 800;
        box-shadow: 0 10px 22px rgba(31, 79, 143, 0.18);
        transition: background 0.15s ease, transform 0.1s ease, box-shadow 0.15s ease;
      }

      :global(.see-more-button:hover) {
        background: var(--accent-2);
        transform: translateY(-1px);
        box-shadow: 0 12px 28px rgba(31, 79, 143, 0.24);
      }

      :global(.social-links) { display: flex; gap: 14px; margin-top: 10px; }
      :global(.social-links a) {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--surface-2);
        transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
      }
      :global(.social-links a:hover) { transform: translateY(-2px); background: var(--surface); box-shadow: var(--shadow-soft); }
      :global(.social-links img) { width: 23px; height: 23px; opacity: 0.88; transition: opacity 0.2s ease; }
      :global(.social-links img:hover) { opacity: 1; transform: none; }

      .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(10, 14, 23, 0.86);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.18s ease;
        z-index: 1000;
      }

      .lightbox.open { opacity: 1; pointer-events: auto; }
      .lightbox-image { max-width: min(1200px, 92vw); max-height: 88vh; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.35); }
      .lightbox-close {
        position: absolute;
        top: 20px;
        right: 24px;
        border: none;
        background: rgba(255,255,255,0.12);
        color: white;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        font-size: 28px;
        line-height: 1;
        cursor: pointer;
      }

      @media (max-width: 720px) {
        .container { padding: 20px 14px 56px; }
        .page-card { padding: 30px 20px; border-radius: 22px; }
        .site-header-inner { align-items: flex-start; flex-direction: column; }
        :global(.hero) { grid-template-columns: 1fr; }
        :global(.hero-image img) { width: 118px; height: 118px; border-radius: 22px; }
        :global(.project-gallery) { grid-template-columns: 1fr; }
      }
    </style>

    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand">Simon Talbi</a>
        <nav>
          <a href="/">Home</a>
          <a href="/projects">Projects</a>
        </nav>
      </div>
    </header>

    <div class="container">
      <div class="page-shell">
        <main class="page-card">
          <slot />
        </main>
      </div>
    </div>

    <footer class="footer">© 2026 Simon Talbi</footer>

    <div id="lightbox" class="lightbox" aria-hidden="true">
      <button
        id="lightbox-close"
        class="lightbox-close"
        aria-label="Close viewer"
      >
        ×
      </button>
      <img id="lightbox-image" class="lightbox-image" src="" alt="" />
    </div>

    <script is:inline>
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightbox-image");
      const lightboxClose = document.getElementById("lightbox-close");

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (
          target instanceof HTMLImageElement &&
          target.classList.contains("gallery-image")
        ) {
          lightboxImage.src = target.src;
          lightboxImage.alt = target.alt || "";
          lightbox.classList.add("open");
          lightbox.setAttribute("aria-hidden", "false");
        }
      });

      lightboxClose?.addEventListener("click", () => {
        lightbox.classList.remove("open");
        lightbox.setAttribute("aria-hidden", "true");
        lightboxImage.src = "";
      });

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) {
          lightbox.classList.remove("open");
          lightbox.setAttribute("aria-hidden", "true");
          lightboxImage.src = "";
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          lightbox.classList.remove("open");
          lightbox.setAttribute("aria-hidden", "true");
          lightboxImage.src = "";
        }
      });
    </script>
  </body>
</html>
